# =============================================================================
# AARA — Environment Configuration
# =============================================================================
# Copy this file to backend/.env and fill in your values.
#   cp .env.example backend/.env
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Development (SQLite — no external server needed):
DATABASE_URL=sqlite+aiosqlite:///./aara.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.neon.tech/database?sslmode=require

# Database pool (PostgreSQL only)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Database migration (production)
# DATABASE_MIGRATION_ON_STARTUP=true

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Token configuration
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# ALGORITHM=HS256
# TOKEN_VERSION=1

# Password policy
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=128
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# ── CORS ────────────────────────────────────────────────────────────────────
# Development:
ALLOWED_ORIGINS=["http://localhost:3000"]
# Production:
# ALLOWED_ORIGINS=["https://aara.vercel.app"]

# ── LLM Provider ────────────────────────────────────────────────────────────
# Google Gemini (free tier — 1500 req/day for 2.0 Flash):
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# OpenAI (paid alternative):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# LLM settings
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096

# ── Redis ───────────────────────────────────────────────────────────────────
# Development (in-memory — no Redis process needed):
REDIS_URL=memory
# Production (Upstash):
# REDIS_URL=rediss://default:password@region.upstash.io:6379

# Redis pool
# REDIS_POOL_SIZE=10
# REDIS_MAX_RETRIES=3
# REDIS_SOCKET_TIMEOUT=5

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FORMAT=json
# DEBUG=false

# ── Vector Store (ChromaDB) ─────────────────────────────────────────────────
# Default: local persistent client
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# VECTORSTORE_PERSIST_DIR=./chroma_data
# VECTORSTORE_COLLECTION_COUNT=5
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Workflow ────────────────────────────────────────────────────────────────
# WORKFLOW_MAX_RETRIES=3
# WORKFLOW_NODE_TIMEOUT=120
# REQUIRE_HUMAN_APPROVAL=false

# Database migration (production)
# DATABASE_MIGRATION_ON_STARTUP=true

# ── Observability ───────────────────────────────────────────────────────────
# ENV=development
# SENTRY_DSN=https://key@o0.ingest.sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Dramatiq (background tasks) ─────────────────────────────────────────────
# DRAMATIQ_REDIS_URL=redis://...

# ── Frontend (.env.local) ───────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8011/api
# JWT_SECRET=must-match-backend-secret-key
