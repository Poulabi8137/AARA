# AARA Production Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file. NEVER use these defaults in production.

# Application Environment
ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.aara.dev
NEXT_PUBLIC_WS_URL=wss://api.aara.dev/api/v1/ws
NEXT_PUBLIC_APP_NAME=AARA
NEXT_PUBLIC_APP_URL=https://aara.dev

# Backend Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS_PER_CORE=1
MAX_WORKERS=4

# Database Configuration (Production)
# PostgreSQL Connection
DATABASE_URL=postgresql://${POSTGRES_USER:-admin}:${POSTGRES_PASSWORD:-secure_password}@postgres:5432/${POSTGRES_DB:-aara}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Connection Security
SSL_MODE=require
CONNECTION_TIMEOUT=30
STATEMENT_TIMEOUT=300000

# Vector Store Configuration
QDRANT_URL=https://qdrant.aara.dev
QDRANT_API_KEY=${QDRANT_API_KEY:-required-for-production}
QDRANT_PREFER_GRPC=true
QDRANT_TIMEOUT=30

# Cache Configuration
REDIS_URL=redis://${REDIS_PASSWORD:-}@redis:6379/0?ssl_cert_req=required
REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_password}
REDIS_SSL=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Authentication Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY:-your-service-key}

# JWT Configuration
JWT_SECRET=${JWT_SECRET:-change-me-to-a-secure-random-secret-at-least-32-characters}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Encryption
ENCRYPTION_KEY=${ENCRYPTION_KEY:-generate-with:python3 -c "import secrets; print(secrets.token_hex(32))"}

# CORS Configuration
CORS_ORIGINS=["https://aara.dev", "https://app.aara.dev", "https://admin.aara.dev"]

# LLM Provider API Keys (set only those you use)
OPENAI_API_KEY=${OPENAI_API_KEY:-}
GEMINI_API_KEY=${GEMINI_API_KEY:-}
GROQ_API_KEY=${GROQ_API_KEY:-}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}

# Ollama (optional local LLM provider)
OLLAMA_BASE_URL=https://ollama.aara.dev
OLLAMA_TIMEOUT=60

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,application/msword,application/vnd.ms-excel
UPLOAD_PATH=/tmp/uploads
STORAGE_PROVIDER=s3

# S3 Storage Configuration (if using S3)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:-}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:-}
AWS_BUCKET_NAME=${AWS_BUCKET_NAME:-aara-documents}
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://s3.amazonaws.com

# Supabase Storage Configuration (if using Supabase)
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_STORAGE_PUBLIC_URL=https://your-storage-url.supabase.co/storage/v1/object/public

# Job Queue Configuration
JOB_QUEUE_BACKEND=redis
CELERY_BROKER_URL=redis://${REDIS_PASSWORD:-}@redis:6379/1
CELERY_RESULT_BACKEND=redis://${REDIS_PASSWORD:-}@redis:6379/2
CELERY_TASK_ACKS_EARLY=true

# Budget Configuration
MONTHLY_BUDGET_DEFAULT=5.00
BUDGET_WARNING_THRESHOLD=80
BUDGET_LIMIT_CHECK_INTERVAL=3600

# Monitoring & Observability
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
METRICS_PORT=9090
LOGGING_FORMAT=json
LOGGING_STRUCTURED=true

# Security Headers & Configuration
ENABLE_CSRF=true
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=Strict

ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

ENABLE_CONTENT_SECURITY_POLICY=true
CONTENT_SECURITY_POLICY=default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; style-src 'self' 'unsafe-inline' https: data:; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss: ws:; frame-ancestors 'none';

# Rate Limiting — "memory" (default) is fine for a single local instance;
# switch to "redis" (reuses REDIS_URL above) once running more than one
# instance, so limits are shared and survive restarts.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/api/v1/ws
WEBSOCKET_TIMEOUT=300
WEBSOCKET_MAX_CONNECTIONS=1000

# API Versioning
API_VERSION=1
API_PREFIX=/api/v${API_VERSION}

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# External API Integrations
ARXIV_API_KEY=${ARXIV_API_KEY:-}
CROSSREF_API_KEY=${CROSSREF_API_KEY:-}
