# Local Development Environment Configuration
# Copy this file to .env and replace placeholder values for local development only

# Database Configuration
# Default local PostgreSQL connection (for development only)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aara
# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Security
# Local development secret key
SECRET_KEY=dev-secret-key-change-in-production-but-at-least-32-chars
# JWT configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
TOKEN_VERSION=1

# Server
# Local development port
APP_PORT=8000
# Local development allowed origins
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
DEBUG=true

# LLM Configuration
# Use mock provider for local development
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
# Local development LLM keys (can be left empty for mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Redis Configuration
# Use in-memory Redis for local development
REDIS_URL=memory
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
DEFAULT_CACHE_TTL=300
REDIS_HEALTH_CHECK_ON_STARTUP=true

# Observability
# Local development Sentry (can be disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Workflow Configuration
WORKFLOW_MAX_RETRIES=3
WORKFLOW_NODE_TIMEOUT=120
REQUIRE_HUMAN_APPROVAL=false

# Environment
ENV=development

# Security Headers
CORS_ALLOW_CREDENTIALS=true
MAX_UPLOAD_SIZE=10485760
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_EXPIRE_HOURS=1
REQUIRE_EMAIL_VERIFICATION=false

# Vector Store
VECTORSTORE_PERSIST_DIR=./chroma_data
VECTORSTORE_COLLECTION_COUNT=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Monitoring
PROMETHEUS_METRICS_ENABLED=false
METRICS_PORT=9090

# Local Development Flags
LOCAL_DEVELOPMENT=true
SKIP_VALIDATION=false
