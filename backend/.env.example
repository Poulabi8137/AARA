# Copy this file to .env and fill in real values.
# Never commit the real .env file.

ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Dev (SQLite, async):
DATABASE_URL=sqlite+aiosqlite:///./aara_dev.db
DATABASE_URL_SYNC=sqlite:///./aara_dev.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Vector store / cache (optional, used by AI features) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379

# --- Rate limiting ---
# "memory" (default) is per-process only: fine for a single local instance,
# but state is lost on restart and invisible to sibling instances behind a
# load balancer. Set to "redis" (reuses REDIS_URL above) for any deployment
# running more than one backend instance.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Auth / security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-dev-jwt-secret-change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ENCRYPTION_KEY=insecure-dev-key-change-me-in-production

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Frontend/backend public URLs (used to build links in emails, etc.) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- SMTP (password reset / transactional email) ---
# Leave SMTP_HOST empty in development: emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@aara.local
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- LLM provider keys (optional, enables real AI agent responses) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Misc ---
MAX_UPLOAD_SIZE_MB=50
JOB_QUEUE_BACKEND=local
MONTHLY_BUDGET_DEFAULT=5.00
